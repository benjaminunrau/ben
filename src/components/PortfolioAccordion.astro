---
import { ChevronDown } from "@lucide/astro";

interface Props {
  heading: string;
  /** Starts open on wide screens and closed on phones. */
  openOnWide?: boolean;
  /** Opens when the page is at, or a link is followed to, this hash (such as "#contact"). */
  opensOnHash?: string;
}

const { heading, openOnWide = false, opensOnHash } = Astro.props;
---

<details class="accordion" data-open-on-wide={openOnWide ? "" : undefined} data-opens-on-hash={opensOnHash}>
  <summary>
    <h3>{heading}</h3>
    <ChevronDown class="accordion-chevron" aria-hidden="true" />
  </summary>
  <div class="accordion-panel">
    <slot />
  </div>
</details>

<script>
  const wide = window.matchMedia("(min-width: 48.0625rem)");
  for (const details of document.querySelectorAll<HTMLDetailsElement>("details[data-open-on-wide]")) details.open = wide.matches;

  const opening = [...document.querySelectorAll<HTMLDetailsElement>("details[data-opens-on-hash]")];
  const openFor = (hash: string) => {
    for (const details of opening) if (details.dataset.opensOnHash === hash) details.open = true;
  };
  openFor(window.location.hash);
  window.addEventListener("hashchange", () => openFor(window.location.hash));
  // Following a link to the hash you are already at fires no hashchange.
  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    if (link) openFor(link.getAttribute("href") ?? "");
  });
</script>

<style>
  .accordion { border: var(--shape-border-width) solid var(--color-border); border-radius: var(--shape-card-radius); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .85rem 1.1rem; border-radius: var(--shape-card-radius); cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--color-surface); }
  summary:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  summary h3 { margin: 0; font-size: 1.1rem; }
  .accordion[open] summary { border-radius: var(--shape-card-radius) var(--shape-card-radius) 0 0; }
  .accordion :global(.accordion-chevron) { flex: 0 0 auto; width: 1.25rem; height: 1.25rem; color: var(--color-muted); transition: transform var(--motion-duration) ease; }
  .accordion[open] :global(.accordion-chevron) { transform: rotate(180deg); }
  .accordion-panel { padding: .25rem 1.1rem 1.1rem; }
  @media (prefers-reduced-motion: reduce) {
    .accordion :global(.accordion-chevron) { transition: none; }
  }
</style>

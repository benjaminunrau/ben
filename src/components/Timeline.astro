---
/** A vertical timeline. Children are `TimelineEntry` components, in the order they should appear. */
---

<ol class="timeline"><slot /></ol>

<style>
  .timeline {
    --timeline-marker: 2.75rem;
    --timeline-gap: 1.25rem;
    position: relative;
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The line runs through the marker centers and fades out after the last entry. */
  .timeline::before {
    content: "";
    position: absolute;
    top: calc(var(--timeline-marker) / 2);
    bottom: 0;
    left: calc(var(--timeline-marker) / 2 - 2px);
    width: 4px;
    border-radius: 2px;
    background: linear-gradient(var(--color-accent), var(--color-primary) 70%, transparent);
    opacity: .55;
  }
  @media (max-width: 48rem) {
    .timeline { --timeline-marker: 2.25rem; --timeline-gap: .85rem; }
  }
</style>
